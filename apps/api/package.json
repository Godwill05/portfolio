{
  "name": "@folioforge/api",
  "version": "1.0.0",
  "private": true,
  "description": "FolioForge REST API — NestJS + TypeORM + MySQL",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/run-seed.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register src/database/seeds/run-seed.ts --demo",
    "create:admin": "ts-node -r tsconfig-paths/register src/database/seeds/create-admin.ts",
    "schema:sync": "typeorm-ts-node-commonjs schema:sync -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/typeorm": "11.0.3",
    "@types/nodemailer": "^7.0.11",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "8.3.0",
    "mysql2": "3.24.6",
    "nodemailer": "^7.0.10",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "0.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.3",
    "ua-parser-js": "2.0.10"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "7.2.1",
    "@types/ua-parser-js": "0.7.39",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.9",
    "vitest": "5.1.1"
  }
}
